# Gere uma chave exclusiva para cada instalação, por exemplo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
CHROME_BINARY_PATH=
PORT=5000
APP_ENV=development
FLASK_DEBUG=0
APP_BASE_URL=http://127.0.0.1:5000
RATELIMIT_STORAGE_URI=memory://

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
ORCAMENTO_VALIDADE_DIAS=15
ADMIN_PODE_AUTOAPROVAR=false
LINK_COMPARTILHAMENTO_DIAS=7
ORCAMENTO_MAX_EMAILS_HORA=5
MONITORAMENTOS_LIMITE_USUARIO=50
MONITORAMENTO_JITTER_SEGUNDOS=300
ALERTAS_PRECO_POR_EMAIL=false
FEATURE_EMPRESARIAL_ENABLED=false
ALCADA_APROVACAO_LIMITE=10000.00
